---
import { config } from '../data/config';
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>Nosotros · {config.brand}</title>
  <meta name="description" content="Conoce por qué en ØPPOSITE elegimos cafés colombianos fuera de lo común." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,600..800;1,9..144,400&family=Archivo:wght@400;600;700&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="top">
    <a class="logo" href="/#top" aria-label={config.brand}><img src="/opposite-logo.svg" alt="ØPPOSITE" /></a>
    <button class="menu-toggle" id="nav-toggle" aria-label="Abrir menú" aria-controls="main-nav" aria-expanded="false"><span></span><span></span><span></span></button>
    <nav id="main-nav"><a href="/#cafes">Los cafés</a><a href="/#metodos">Métodos</a><a href="/#filtros">Filtros</a><a href="/nosotros" aria-current="page">Nosotros</a></nav>
    <a class="cartbtn" href="/#cafes">Ver cafés</a>
  </header>

  <main>
    <a class="back" href="/#top">← Volver al inicio</a>
    <section class="about-hero">
      <p class="eyebrow">Una mirada distinta al café colombiano</p>
      <h1>¿Por qué<br /><span>ØPPOSITE?</span></h1>
      <div class="rule" aria-hidden="true"><i></i></div>
      <p class="intro">Porque nos mueve descubrir lo que se sale de lo habitual.</p>
    </section>

    <section class="about-copy">
      <p>En ØPPOSITE elegimos mirar el café desde otro lugar. No buscamos seguir cada tendencia ni ofrecer lo que ya se encuentra en todas partes: nos interesan los cafés que despiertan curiosidad, que cuentan algo propio y que invitan a detenerse un momento.</p>
      <p>Por eso buscamos variedades, procesos y productores capaces de dar vida a tazas únicas. Cada café que seleccionamos tiene un carácter distinto y una historia detrás; queremos acercarte a esas diferencias con honestidad, sin decirte de antemano qué debes sentir o encontrar.</p>
      <p>Creemos que una buena taza puede ser más que una rutina. Puede convertirse en una pausa para explorar, compartir y descubrir algo nuevo. Esa es nuestra idea de ir en otra dirección: elegir con intención y dejar que cada persona encuentre su propia experiencia.</p>
      <a class="btn" href="/#cafes">Descubre nuestros cafés</a>
    </section>
  </main>

  <footer><p>{config.brand} · {config.shipping}</p></footer>

  <script is:inline>
    const topBar = document.querySelector('.top');
    const menuButton = document.querySelector('#nav-toggle');
    const nav = document.querySelector('#main-nav');
    function closeMenu() { topBar.classList.remove('menu-open'); menuButton.setAttribute('aria-expanded', 'false'); menuButton.setAttribute('aria-label', 'Abrir menú'); }
    menuButton.addEventListener('click', () => {
      const isOpen = menuButton.getAttribute('aria-expanded') !== 'true';
      topBar.classList.toggle('menu-open', isOpen);
      menuButton.setAttribute('aria-expanded', String(isOpen));
      menuButton.setAttribute('aria-label', isOpen ? 'Cerrar menú' : 'Abrir menú');
    });
    nav.addEventListener('click', event => { if (event.target.closest('a')) closeMenu(); });
    document.addEventListener('keydown', event => { if (event.key === 'Escape') closeMenu(); });
  </script>

  <style is:global>
    :root{--cream:#efe6d2;--ink:#1a120d;--sun:#f7b32b;--teal:#7fd1c7;--night:#0c0c0c;--green:#0e6b4a;--pink:#e6007e}
    *{box-sizing:border-box;margin:0}body{font-family:Archivo,system-ui,sans-serif;background:var(--cream);color:var(--ink);line-height:1.6}h1,h2{font-family:Fraunces,Georgia,serif;font-weight:800;line-height:1.05}a{color:inherit}:focus-visible{outline:3px solid var(--pink);outline-offset:3px}
    .top{position:sticky;top:0;z-index:5;display:flex;align-items:center;gap:1rem;padding:.6rem 1.25rem;background:var(--night);color:var(--cream)}.logo{display:flex;align-items:center;text-decoration:none;white-space:nowrap}.logo img{display:block;width:8.1rem;height:auto}.top nav{position:absolute;left:50%;translate:-50% 0;display:flex;gap:1.25rem;margin:0;white-space:nowrap}.top nav a{text-decoration:none}.top nav a:hover,.top nav a[aria-current="page"]{color:var(--teal)}.top .cartbtn{margin-left:auto}.cartbtn{background:var(--sun);color:var(--ink);border-radius:99px;padding:.45rem 1rem;font:600 .9rem Archivo;text-decoration:none}.menu-toggle{display:none}
    main{max-width:72rem;margin:auto;padding:1.25rem}.back{display:inline-block;margin:1.25rem 0;text-decoration:none;font-weight:600}.about-hero{position:relative;overflow:hidden;margin-top:.5rem;padding:clamp(3rem,10vw,7rem) clamp(1.5rem,8vw,7rem);border-radius:1.5rem;background:#183b3b;color:var(--cream)}.about-hero:after{content:"";position:absolute;z-index:0;width:min(48rem,100vw);aspect-ratio:1;right:-14rem;top:50%;translate:0 -50%;border-radius:50%;background:repeating-radial-gradient(circle,transparent 0 2.3rem,rgba(127,209,199,.15) 2.35rem 2.42rem)}.eyebrow{position:relative;z-index:1;color:var(--teal);font-size:.75rem;font-weight:700;letter-spacing:.16em;text-transform:uppercase}.about-hero h1{position:relative;z-index:1;margin:1rem 0;font-size:clamp(3.5rem,10vw,7rem);letter-spacing:-.04em}.about-hero h1 span{color:var(--sun)}.rule{position:relative;z-index:1;display:flex;align-items:center;gap:.7rem;width:min(20rem,80%);margin:1.5rem 0;color:var(--sun)}.rule:before,.rule:after{content:"";height:1px;flex:1;background:currentColor}.rule i{width:.55rem;height:.55rem;background:currentColor;transform:rotate(45deg)}.intro{position:relative;z-index:1;max-width:36rem;font:italic 1.35rem Fraunces,Georgia,serif}.about-copy{max-width:52rem;padding:clamp(2.5rem,7vw,5rem) 1rem;margin:auto}.about-copy p{margin:0 0 1.2rem;font-size:clamp(1rem,2vw,1.15rem)}.btn{display:inline-block;margin-top:.6rem;background:var(--ink);color:var(--cream);border-radius:99px;padding:.75rem 1.35rem;font:600 .95rem Archivo;text-decoration:none}.btn:hover{background:var(--green)}footer{padding:2rem 1.25rem;text-align:center;font-size:.85rem;background:var(--night);color:var(--cream)}
    @media(max-width:650px){.top{gap:.55rem;padding:.6rem .7rem}.logo img{width:6.7rem}.menu-toggle{display:grid;place-content:center;gap:4px;width:2.2rem;height:2.2rem;flex:0 0 auto;border:1px solid #efe6d255;border-radius:50%;background:transparent;color:var(--cream);cursor:pointer}.menu-toggle span{display:block;width:1rem;height:2px;background:currentColor;transition:transform .2s,opacity .2s}.top.menu-open .menu-toggle span:first-child{transform:translateY(6px) rotate(45deg)}.top.menu-open .menu-toggle span:nth-child(2){opacity:0}.top.menu-open .menu-toggle span:last-child{transform:translateY(-6px) rotate(-45deg)}.top nav{display:none;position:absolute;left:0;right:0;top:100%;translate:0 0;width:100%;flex-direction:column;gap:0;padding:.4rem 1rem .8rem;background:var(--night);white-space:normal}.top.menu-open nav{display:flex}.top nav a{padding:.75rem .25rem;font-size:.95rem;border-top:1px solid #efe6d233}.top .cartbtn{margin-left:auto;padding:.4rem .7rem;font-size:.78rem;white-space:nowrap}.about-hero{padding:3.5rem 1.5rem}.about-hero:after{right:-19rem}.about-copy{padding:2.5rem .4rem}}
  </style>
</body>
</html>
