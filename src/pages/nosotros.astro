---
import Page from '../layouts/Page.astro';
import { config } from '../data/config';
import { products } from '../data/products';
import { farmPhotos, farmCopy } from '../data/farm';

// Fincas con las que trabajamos hoy, tomadas del catálogo para que nunca se desactualicen.
const farms = Object.values(
  products.filter(p => p.category === 'cafe' && p.farm).reduce<Record<string, { farm: string; producers: string; origin: string; coffees: string[]; soon: string[] }>>((acc, p) => {
    const entry = acc[p.farm!] ??= { farm: p.farm!, producers: p.producer ?? '', origin: p.origin ?? '', coffees: [], soon: [] };
    (p.available === false ? entry.soon : entry.coffees).push(p.name);
    return acc;
  }, {}),
);
const showPlaceholders = import.meta.env.DEV && farmPhotos.length === 0;
---
<Page title="Nosotros" description="Conoce a ØPPOSITE: cafés colombianos fuera de lo común, las fincas de donde vienen y la gente detrás." current="nosotros">
  <section class="brand-hero" id="top">
    <div class="hero-rings" aria-hidden="true"></div>
    <div class="hero-copy">
      <p class="eyebrow">Nosotros</p>
      <h1>Cafés colombianos que se salen del camino habitual.</h1>
      <p class="hero-intro">Elegimos pocos cafés, con procesos y variedades poco comunes, y te contamos de quién y de dónde vienen.</p>
      <div class="hero-actions"><a class="btn btn-sun" href="/historia">Lee cómo empezó</a><a class="text-link" href="/#cafes">Ver los cafés <span aria-hidden="true">↗</span></a></div>
    </div>
    <img class="hero-mark" src="/opposite-transition-mark.svg" alt="" aria-hidden="true" />
  </section>

  <section class="about-intro">
    <h2>Un proyecto para descubrir, no para dictar.</h2>
    <div class="about-copy">
      <p>ØPPOSITE nació para explorar y compartir cafés colombianos poco comunes, procesos interesantes y perfiles que inviten a descubrir algo diferente.</p>
      <p>No queremos decirte cómo debe saber un café ni qué tienes que encontrar en tu taza. Compartimos lo que nos emociona y dejamos que construyas tu propia experiencia.</p>
    </div>
  </section>

  <section class="manifesto" aria-labelledby="values-title">
    <h2 id="values-title">Lo que nos guía</h2>
    <div class="manifesto-grid">
      <article><h3>Elegimos con curiosidad</h3><p>Nos atraen las variedades y los procesos que no aparecen en todas partes y que nos invitan a mirar de nuevo.</p></article>
      <article><h3>Reconocemos el origen</h3><p>Cada café viene del trabajo de personas y fincas con una historia propia. Queremos acercarte a ella.</p></article>
      <article><h3>Dejamos espacio para ti</h3><p>Compartimos lo que nos mueve, sin convertir nuestras impresiones en reglas para tu taza.</p></article>
    </div>
  </section>

  <section class="farms" aria-labelledby="farms-title">
    <h2 id="farms-title">Las fincas detrás de cada taza</h2>
    <ul class="farm-list">
      {farms.map(f => (
        <li>
          <h3>{f.farm}</h3>
          <p>{f.producers}</p>
          <p class="farm-meta">{f.origin}</p>
          {f.coffees.length > 0 && <p class="farm-meta">En nuestra selección: {f.coffees.join(', ')}</p>}
          {f.soon.length > 0 && <p class="farm-meta">Próximamente: {f.soon.join(', ')}</p>}
        </li>
      ))}
    </ul>
  </section>

  {(farmPhotos.length > 0 || showPlaceholders) && (
    <section class="gallery-section" aria-labelledby="gallery-title">
      <div class="gallery-head"><h2 id="gallery-title">{farmCopy.title}</h2><p>{farmCopy.intro}</p></div>
      <ul class="gallery">
        {farmPhotos.map(photo => (
          <li class={photo.wide ? 'wide' : ''}>
            <figure><img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" />{photo.caption && <figcaption>{photo.caption}</figcaption>}</figure>
          </li>
        ))}
        {showPlaceholders && [1, 2, 3].map(n => <li class={n === 1 ? 'wide' : ''}><div class="photo-slot">Foto {n} de la finca (solo visible en desarrollo)</div></li>)}
      </ul>
    </section>
  )}

  <section class="closing-note">
    <img src="/opposite-transition-mark.svg" alt="" aria-hidden="true" />
    <p>¿Te gustaría hacer parte de esto?</p>
    <a href="/trabaja-con-nosotros">Trabaja con nosotros <span aria-hidden="true">→</span></a>
  </section>
</Page>

<style is:global>
  .about-intro{display:grid;grid-template-columns:.82fr 1fr;gap:clamp(2rem,7vw,6rem);padding:clamp(3rem,8vw,6rem) clamp(.25rem,3vw,2rem)}
  .about-intro h2,.farms h2,.gallery-head h2{font-size:clamp(2rem,4.2vw,3.2rem);letter-spacing:-.02em}
  .about-copy{max-width:65ch}.about-copy p{margin:0 0 1.1rem;font-size:1.0625rem}
  .farms{padding:clamp(2rem,5vw,3.5rem) clamp(.25rem,3vw,2rem)}
  .farm-list{display:grid;grid-template-columns:repeat(auto-fit,minmax(16rem,1fr));gap:1.5rem;margin:1.75rem 0 0;padding:0;list-style:none}
  .farm-list li{padding:1.25rem 0 0;border-top:1px solid #1a120d55}.farm-list h3{margin-bottom:.35rem;font:700 1.35rem "Source Serif 4",Georgia,serif}
  .farm-meta{font-size:.875rem;color:#4f463c}
  .gallery-section{padding:clamp(2rem,5vw,3.5rem) 0}.gallery-head{display:grid;gap:.5rem;margin:0 clamp(.25rem,3vw,2rem) 1.5rem}.gallery-head p{max-width:65ch}
  .gallery{display:grid;grid-template-columns:repeat(auto-fill,minmax(15rem,1fr));gap:1rem;margin:0;padding:0;list-style:none}
  .gallery li.wide{grid-column:span 2}.gallery figure{margin:0}.gallery img{display:block;width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:1rem;background:#ded4bd}
  .gallery figcaption{margin-top:.5rem;font-size:.875rem;color:#4f463c}
  .photo-slot{display:grid;place-items:center;aspect-ratio:4/3;padding:1rem;border:2px dashed #1a120d66;border-radius:1rem;text-align:center;font-size:.875rem;color:#4f463c}
  @media(max-width:850px){.about-intro{grid-template-columns:1fr;gap:1.25rem}}
  @media(max-width:650px){.gallery li.wide{grid-column:auto}}
</style>
