---
import { config } from '../data/config';
import PageTransition from '../components/PageTransition.astro';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>Estado del pago · {config.brand}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:wght@600;700;800&family=Archivo:wght@400;600;700&display=swap" rel="stylesheet" />
</head>
<body>
  <PageTransition />
  <Analytics />
  <SpeedInsights />
  <main>
    <img class="logo" src="/opposite-logo.svg" alt="ØPPOSITE" />
    <p class="eyebrow">Tu pedido en ØPPOSITE</p>
    <h1 id="title">Estamos verificando tu pago</h1>
    <p id="message" role="status" aria-live="polite">Espera un momento mientras confirmamos la operación con Mercado Pago.</p>
    <p id="order" hidden></p>
    <a href="/#cafes">Volver a los cafés</a>
  </main>
  <script is:inline>
    const params = new URLSearchParams(location.search);
    const result = params.get('resultado');
    const orderId = params.get('order_id') || params.get('data.id');
    const title = document.querySelector('#title');
    const message = document.querySelector('#message');
    const order = document.querySelector('#order');
    if (orderId) {
      order.hidden = false;
      order.textContent = `Pedido: ${orderId}`;
      let attempts = 0;
      const checkStatus = async () => {
        try {
          const response = await fetch(`/api/mercadopago/order-status?order_id=${encodeURIComponent(orderId)}`, { cache: 'no-store' });
          const data = await response.json();
          if (data.status === 'paid') {
            title.textContent = '¡Pago confirmado!';
            message.textContent = 'Mercado Pago confirmó tu pago. El envío seleccionado quedó incluido en el total. Gracias por elegir ØPPOSITE.';
            return;
          }
          if (data.status === 'rejected') {
            title.textContent = 'No se completó el pago';
            message.textContent = 'Puedes volver a los cafés e intentarlo otra vez. Si necesitas ayuda, escríbenos por WhatsApp.';
            return;
          }
          if (data.status === 'refunded') {
            title.textContent = 'Este pago fue reembolsado';
            message.textContent = 'Mercado Pago reporta que el pago se reembolsó. Si tienes dudas sobre el pedido, escríbenos por WhatsApp.';
            return;
          }
        } catch { /* Keep the customer informed if the status service is briefly unavailable. */ }
        attempts += 1;
        if (attempts < 8) {
          message.textContent = 'El pago aún aparece pendiente. Seguiremos consultando a Mercado Pago unos segundos.';
          window.setTimeout(checkStatus, 5000);
        } else {
          title.textContent = result === 'rechazado' ? 'No se completó el pago' : 'Tu pago sigue en verificación';
          message.textContent = result === 'rechazado'
            ? 'Puedes volver a los cafés e intentarlo otra vez. Si necesitas ayuda, escríbenos por WhatsApp.'
            : 'Mercado Pago todavía no confirma el estado. Puedes volver a esta página más tarde o revisar la operación en tu cuenta de Mercado Pago.';
        }
      };
      checkStatus();
    } else if (result === 'rechazado') {
      title.textContent = 'No se completó el pago';
      message.textContent = 'Puedes volver a los cafés e intentarlo otra vez. Si necesitas ayuda, escríbenos por WhatsApp.';
    } else if (result === 'pendiente') {
      title.textContent = 'Tu pago está pendiente';
      message.textContent = 'Mercado Pago aún no ha enviado un identificador de pedido para confirmar. Revisa el estado en tu cuenta de Mercado Pago.';
    } else {
      title.textContent = 'Volviste de Mercado Pago';
      message.textContent = 'No recibimos un número de pedido para verificar el pago. Consulta el estado de la operación en tu cuenta de Mercado Pago.';
    }
  </script>
  <style is:global>
    :root{--cream:#efe6d2;--ink:#1a120d;--green:#0e6b4a;--night:#0c0c0c}
    *{box-sizing:border-box;margin:0}body{min-height:100vh;display:grid;place-items:center;padding:1.25rem;background:var(--cream);color:var(--ink);font-family:Archivo,system-ui,sans-serif}main{width:min(100%,42rem);padding:clamp(2rem,7vw,4rem);border-radius:1.5rem;background:var(--night);color:var(--cream)}.logo{width:9rem;height:auto;margin-bottom:3rem}.eyebrow{text-transform:uppercase;letter-spacing:.16em;font-size:.75rem;font-weight:700;color:#7fd1c7}h1{margin:.7rem 0 1rem;font:800 clamp(2.4rem,8vw,4.6rem)/1 "Source Serif 4",Georgia,serif}main>p:not(.eyebrow){font-size:1.05rem;line-height:1.6;max-width:55ch}#order{margin-top:1rem;color:#b9b2a2;font-size:.85rem}a{display:inline-block;margin-top:2rem;padding:.8rem 1.2rem;border-radius:99px;background:#f7b32b;color:var(--ink);font-weight:700;text-decoration:none}
  </style>
</body>
</html>
