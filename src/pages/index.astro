---
import { products } from '../data/products';
import { config } from '../data/config';
import { colombianDepartments, commonMunicipalities } from '../data/locations';
import PageTransition from '../components/PageTransition.astro';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
const cop = (n: number) => '$' + n.toLocaleString('es-CO');
const cafes = products.filter(p => p.category === 'cafe');
const metodos = products.filter(p => p.category === 'metodo');
const filtros = products.filter(p => p.category === 'filtro');
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>Preventa de café · {config.brand}</title>
  <meta name="description" content="Preventa de tres cafés de especialidad del Huila, disponibles en bolsas de 250 g y 340 g." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,600..800;1,8..60,400&family=Archivo:wght@400;600;700&display=swap" rel="stylesheet" />
</head>
<body>
  <PageTransition />
  <Analytics />
  <SpeedInsights />
  <header class="top">
    <a class="logo" href="#top" aria-label={config.brand}><img src="/opposite-logo.svg" alt="ØPPOSITE" /></a>
    <button class="menu-toggle" id="nav-toggle" aria-label="Abrir menú" aria-controls="main-nav" aria-expanded="false"><span></span><span></span><span></span></button>
    <nav id="main-nav">
      <a href="#cafes">Cafés</a><a href="#metodos">Métodos</a><a href="#filtros">Filtros</a><a href="/nosotros">Nosotros</a>
    </nav>
    <button class="cartbtn" id="open-cart">Carrito <b id="count">0</b></button>
  </header>

  <main id="top">
    <section class="hero">
      <div class="sunburst" aria-hidden="true"></div>
      <div class="label hero-label">
        <p class="small">Café de especialidad · Colombia</p>
        <h1>Preventa</h1>
        <div class="rule"><i></i></div>
        <p class="lead">Tres cafés del Huila en bolsas de 250 g o 340 g. Aparta el tuyo y sé parte de esta primera preventa.</p>
        <p class="meta">{config.presaleEnd}</p>
        <a class="btn" href="#cafes">Ver los cafés</a>
      </div>
    </section>

    <section id="cafes" class="block">
      <h2>Los tres cafés</h2>
      <div class="grid cafes">
        {cafes.map(p => (
          <article class={`card cafe ${p.theme}`}>
            <div class="photo"><img src={p.img} alt={p.gallery ? `${p.name} servido junto a su empaque` : `Bolsa de café ${p.name}`} loading="lazy" /></div>
            <div class="label">
              <p class="small">{p.tag}</p>
              <h3>{p.name}</h3>
              <div class="rule"><i></i></div>
              <dl>
                <dt>Proceso</dt><dd>{p.process}</dd>
                <dt>Productor</dt><dd>{p.producer}</dd>
                <dt>Finca</dt><dd>{p.farm}</dd>
              </dl>
              <p class="small">{p.origin}</p>
              <div class="buy">
                <span class="price">{cop(p.price)} <small>· 250 g</small></span>
                <a class="btn" href={`/cafes/${p.id}`}>Conocer café</a>
              </div>
              <label class="size-picker">Presentación
                <select data-size-picker data-id={p.id}>
                  <option value="250" data-price={p.price}>250 g · {cop(p.price)}</option>
                  <option value="340" data-price={p.price340 || p.price}>340 g · {cop(p.price340 || p.price)}</option>
                </select>
              </label>
              <label class="grind-picker">Preparación
                <select data-grind-picker>
                  <option value="bean">Grano entero · sin moler</option>
                  <option value="fine">Molienda fina · espresso</option>
                  <option value="medium">Molienda media · V60, AeroPress u Origami</option>
                  <option value="coarse">Molienda gruesa · prensa francesa</option>
                </select>
              </label>
              <button class="btn add reserve" data-id={p.id} data-size="250">Reservar · 250 g</button>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="brand-intro" aria-labelledby="brand-intro-title">
      <div class="intro-heading">
        <p class="small">Una mirada distinta al café colombiano</p>
        <h2 id="brand-intro-title">Salir de lo habitual también es <span>acercarse.</span></h2>
      </div>
      <div class="intro-copy">
        <p>En ØPPOSITE buscamos cafés colombianos que despierten curiosidad: variedades, orígenes y procesos que invitan a mirar de nuevo. Oponerse no es una pose; es elegir con criterio y dejar espacio para descubrir.</p>
        <p>Cada selección tiene una razón para detenerte, mirar de cerca y preparar la taza a tu manera.</p>
        <a href="/nosotros">Conoce lo que nos mueve <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="presale-info">
      <div class="presale-copy">
        <p class="small">Una preventa en lotes pequeños</p>
        <h2>10 kg de cada café</h2>
        <p>Por ahora decidimos sacar 10 kg de cada café. Cuando completemos la preventa de uno, procesamos su tueste y preparamos el despacho.</p>
        <p>Así tostamos según lo que se reservó. Los despachos están previstos para la primera semana de diciembre.</p>
      </div>
      <div class="presale-mark" aria-hidden="true"><strong>10</strong><span>kg<br />por café</span></div>
    </section>

    <section id="metodos" class="block alt">
      <h2>Métodos</h2>
      <div class="grid simple">
        {metodos.map(p => (
          <article class="card simple-card">
            {p.img && <div class="product-photo"><img src={p.img} alt={p.name} loading="lazy" /></div>}
            <h3>{p.name}</h3><p>{p.note}</p>
            <div class="buy"><span class="price">{cop(p.price)}</span>
            <button class="btn add" data-id={p.id}>Agregar</button></div>
          </article>
        ))}
      </div>
    </section>

    <section id="filtros" class="block alt2">
      <h2>Filtros</h2>
      <div class="grid simple">
        {filtros.map(p => (
          <article class="card simple-card">
            {p.img && <div class="product-photo"><img src={p.img} alt={p.name} loading="lazy" /></div>}
            <h3>{p.name}</h3><p>{p.note}</p>
            <div class="buy"><span class="price">{cop(p.price)}</span>
            <button class="btn add" data-id={p.id}>Agregar</button></div>
          </article>
        ))}
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="footer-top"><p>Algo distinto está por servirse.</p><a href="#cafes">Explora los cafés <span aria-hidden="true">↗</span></a></div>
    <a class="footer-wordmark" href="#top" aria-label="ØPPOSITE, volver al inicio">ØPPOSITE</a>
    <div class="footer-bottom"><span>Colombia</span><a href="#top">Volver arriba <span aria-hidden="true">↑</span></a></div>
  </footer>

  <dialog id="cart">
    <form method="dialog" class="cart-head"><h2>Tu pedido</h2><button aria-label="Cerrar">Cerrar</button></form>
    <ul id="lines"></ul>
    <p id="empty">Aún no has agregado nada.</p>
    <div class="shipping-row"><span>Productos</span><strong id="subtotal">$0</strong></div>
    <div class="shipping-row"><span>Envío <small id="shipping-destination"></small></span><strong id="shipping-fee">—</strong></div>
    <div class="total"><span>Total</span><strong id="total">$0</strong></div>
    <label>Nombre<input id="name" autocomplete="name" /></label>
    <label>Departamento / región<select id="department" autocomplete="address-level1" required>
      <option value="">Selecciona tu departamento</option>
      {colombianDepartments.map(department => <option value={department}>{department}</option>)}
    </select></label>
    <label>Ciudad / municipio<input id="city" list="municipalities" autocomplete="address-level2" placeholder="Escribe o elige tu municipio" required />
      <datalist id="municipalities">{commonMunicipalities.map(city => <option value={city} />)}</datalist>
    </label>
    <label>Correo para el pago<input id="email" type="email" autocomplete="email" /></label>
    <button class="btn wide" id="pay-mercadopago" disabled>Continuar a Mercado Pago</button>
    <p class="payment-note">El pago se procesa de forma segura con Mercado Pago. Envío: $6.000 en Bogotá D. C. y $15.000 en el resto del país; se suma al total.</p>
    <p id="payment-error" class="payment-error" role="alert" hidden></p>
    <button class="btn wide whatsapp-order" id="send" disabled>Enviar pedido por WhatsApp</button>
    <p class="fine">Te confirmamos el pago y el envío por WhatsApp.</p>
  </dialog>

  <script is:inline define:vars={{ products, config }}>
    const fmt = n => '$' + n.toLocaleString('es-CO');
    let cart = {};
    try { cart = JSON.parse(localStorage.getItem('cart') || '{}'); } catch {}
    const $ = s => document.querySelector(s);
    const dlg = $('#cart');
    const header = document.querySelector('.top');
    const menuToggle = $('#nav-toggle');
    const departmentInput = $('#department');
    const cityInput = $('#city');
    const normalizeLocation = value => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').trim().toLocaleLowerCase('es');
    function destinationShipping() {
      const department = departmentInput.value;
      const city = cityInput.value.trim();
      if (!department || !city) return null;
      return normalizeLocation(department) === normalizeLocation('Bogotá, D.C.') ? 6000 : 15000;
    }
    function closeMenu() { header.classList.remove('menu-open'); menuToggle.setAttribute('aria-expanded', 'false'); menuToggle.setAttribute('aria-label', 'Abrir menú'); }
    menuToggle.onclick = () => {
      const isOpen = menuToggle.getAttribute('aria-expanded') !== 'true';
      header.classList.toggle('menu-open', isOpen);
      menuToggle.setAttribute('aria-expanded', String(isOpen));
      menuToggle.setAttribute('aria-label', isOpen ? 'Cerrar menú' : 'Abrir menú');
    };
    $('#main-nav').addEventListener('click', e => { if (e.target.closest('a')) closeMenu(); });
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeMenu(); });
    function save() { try { localStorage.setItem('cart', JSON.stringify(cart)); } catch {} render(); }
    function cartInfo(key) {
      const [id, selectedSize, selectedGrind] = key.split('::');
      const product = products.find(x => x.id === id);
      if (!product) return null;
      const size = product.category === 'cafe' ? (selectedSize || '250') : null;
      const grind = product.category === 'cafe' ? (selectedGrind || 'bean') : null;
      const grindNames = { bean: 'Grano entero · sin moler', fine: 'Molienda fina · espresso', medium: 'Molienda media · V60, AeroPress u Origami', coarse: 'Molienda gruesa · prensa francesa' };
      return { product, size, grind, grindName: grind ? grindNames[grind] : null, price: size === '340' ? product.price340 : product.price };
    }
    function render() {
      const ids = Object.keys(cart).filter(id => cart[id] > 0);
      let total = 0, count = 0;
      $('#lines').innerHTML = ids.map(id => {
        const item = cartInfo(id); if (!item) return '';
        const { product: p, size, grindName, price } = item; const q = cart[id];
        total += price * q; count += q;
        const isCoffee = p.category === 'cafe';
        const thumb = `<img class="cart-thumb" src="${p.img}" alt="${p.name}" />`;
        const linkedThumb = isCoffee ? `<a class="cart-thumb-link" href="/cafes/${p.id}" aria-label="Ver ${p.name}">${thumb}</a>` : thumb;
        const name = `${p.name}${isCoffee ? ` · ${size} g · ${grindName}` : ''}`;
        const linkedName = isCoffee ? `<a class="cart-product-link" href="/cafes/${p.id}">${name}</a>` : `<span class="cart-product">${name}</span>`;
        return `<li>${linkedThumb}${linkedName}
          <span class="qty"><button data-d="-1" data-id="${id}" aria-label="Quitar uno">−</button><b>${q}</b><button data-d="1" data-id="${id}" aria-label="Agregar uno">+</button></span>
          <span>${fmt(price * q)}</span></li>`;
      }).join('');
      $('#empty').hidden = ids.length > 0;
      const shipping = destinationShipping();
      $('#subtotal').textContent = fmt(total);
      $('#shipping-fee').textContent = shipping === null ? 'Selecciona destino' : fmt(shipping);
      $('#shipping-destination').textContent = shipping === null ? '' : `· ${cityInput.value.trim()}, ${departmentInput.value}`;
      $('#total').textContent = fmt(total + (shipping || 0));
      $('#count').textContent = count;
      $('#send').disabled = !ids.length || shipping === null;
      $('#pay-mercadopago').disabled = !ids.length || shipping === null;
    }
    document.addEventListener('click', e => {
      const add = e.target.closest('.add');
      if (add) {
        const card = add.closest('.cafe');
        const key = add.dataset.size ? `${add.dataset.id}::${add.dataset.size}::${card.querySelector('[data-grind-picker]').value}` : add.dataset.id;
        cart[key] = (cart[key] || 0) + 1; save();
        const t = add.textContent; add.textContent = 'Agregado'; setTimeout(() => add.textContent = t, 900);
      }
      const step = e.target.closest('[data-d]');
      if (step) { cart[step.dataset.id] = Math.max(0, (cart[step.dataset.id] || 0) + Number(step.dataset.d)); save(); }
    });
    $('#open-cart').onclick = () => dlg.showModal();
    $('#pay-mercadopago').onclick = async () => {
      const button = $('#pay-mercadopago');
      const error = $('#payment-error');
      error.hidden = true;
      const buyer = { name: $('#name').value.trim(), email: $('#email').value.trim() };
      buyer.department = departmentInput.value;
      buyer.city = cityInput.value.trim();
      if (!buyer.name || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(buyer.email)) {
        error.textContent = 'Escribe tu nombre y un correo válido para continuar al pago.';
        error.hidden = false;
        return;
      }
      if (!buyer.department || !buyer.city) {
        error.textContent = 'Selecciona tu departamento y escribe o elige tu ciudad o municipio.';
        error.hidden = false;
        return;
      }
      button.disabled = true;
      button.textContent = 'Conectando con Mercado Pago…';
      try {
        const response = await fetch('/api/mercadopago/create-order', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            buyer,
            items: Object.keys(cart).filter(key => cart[key] > 0).map(key => ({ key, quantity: cart[key] })),
          }),
        });
        const result = await response.json();
        if (!response.ok || typeof result.checkoutUrl !== 'string') throw new Error(result.error || 'No pudimos iniciar el pago.');
        const checkoutUrl = new URL(result.checkoutUrl);
        if (checkoutUrl.protocol !== 'https:' || !(checkoutUrl.hostname === 'mercadopago.com.co' || checkoutUrl.hostname.endsWith('.mercadopago.com.co'))) throw new Error('Mercado Pago devolvió una dirección de pago no válida.');
        window.location.assign(checkoutUrl.href);
      } catch (cause) {
        error.textContent = cause instanceof Error ? cause.message : 'No pudimos iniciar el pago. Vuelve a intentarlo.';
        error.hidden = false;
        button.disabled = false;
        button.textContent = 'Continuar a Mercado Pago';
      }
    };
    $('#send').onclick = () => {
      const ids = Object.keys(cart).filter(id => cart[id] > 0);
      let total = 0;
      const lines = ids.map(id => { const item = cartInfo(id); if (!item) return ''; const { product: p, size, grindName, price } = item; total += price * cart[id];
        return `• ${cart[id]} × ${p.name}${p.category === 'cafe' ? ` (${size} g, ${grindName})` : ''} — ${fmt(price * cart[id])}`; }).filter(Boolean);
      const shipping = destinationShipping();
      if (!departmentInput.value || !cityInput.value.trim()) { $('#payment-error').textContent = 'Selecciona tu departamento y escribe o elige tu ciudad o municipio.'; $('#payment-error').hidden = false; return; }
      const msg = `Hola, quiero hacer un pedido de preventa:\n${lines.join('\n')}\nEnvío a ${cityInput.value.trim()}, ${departmentInput.value}: ${fmt(shipping)}\nTotal con envío: ${fmt(total + shipping)}\nNombre: ${$('#name').value}\nCorreo: ${$('#email').value}`;
      window.open(`https://wa.me/${config.whatsapp}?text=${encodeURIComponent(msg)}`, '_blank');
    };
    departmentInput.addEventListener('change', render);
    cityInput.addEventListener('input', render);
    render();
    document.querySelectorAll('[data-size-picker]').forEach(select => select.addEventListener('change', () => {
      const card = select.closest('.cafe');
      const option = select.selectedOptions[0];
      const size = select.value;
      card.querySelector('.price').innerHTML = `${fmt(Number(option.dataset.price))} <small>· ${size} g</small>`;
      const reserve = card.querySelector('.reserve');
      reserve.dataset.size = size;
      reserve.textContent = `Reservar · ${size} g`;
    }));
    if (new URLSearchParams(location.search).get('openCart') === '1') {
      dlg.showModal();
      history.replaceState(null, '', '/#cafes');
    }
  </script>

  <style is:global>
    :root {
      --cream:#efe6d2; --ink:#1a120d; --orange:#f07b1d; --sun:#f7b32b; --teal:#7fd1c7;
      --pink:#e6007e; --green:#0e6b4a; --wine:#9b0e1a; --night:#0c0c0c; --purple:#6a1b7a;
    }
    *{box-sizing:border-box;margin:0}
    html{scroll-behavior:smooth}
    body{font-family:Archivo,system-ui,sans-serif;background:var(--cream);color:var(--ink);line-height:1.5}
    h1,h2,h3{font-family:"Source Serif 4",Georgia,serif;font-weight:800;line-height:1}
    a{color:inherit}
    :focus-visible{outline:3px solid var(--pink);outline-offset:2px}
    .top{position:sticky;top:0;z-index:5;display:flex;align-items:center;gap:1rem;padding:.6rem 1.25rem;background:var(--night);color:var(--cream)}
    .logo{display:flex;align-items:center;text-decoration:none;white-space:nowrap}
    .logo img{display:block;width:8.1rem;height:auto}
    .top nav{position:absolute;left:50%;translate:-50% 0;display:flex;gap:1.25rem;margin:0;white-space:nowrap}
    .top nav a{text-decoration:none;font-size:.95rem}
    .top nav a:hover{color:var(--sun)}
    .cartbtn{background:var(--sun);color:var(--ink);border:0;border-radius:99px;padding:.45rem 1rem;font:600 .9rem Archivo;cursor:pointer}
    .top .cartbtn{margin-left:auto}
    .cartbtn b{background:var(--ink);color:var(--sun);border-radius:99px;padding:0 .5rem;margin-left:.3rem}
    .menu-toggle{display:none}

    .small{font-size:.7rem;letter-spacing:.16em;text-transform:uppercase;font-weight:700;color:var(--accent,var(--green))}
    .rule{display:flex;align-items:center;gap:.6rem;margin:1rem 0;color:var(--accent,var(--wine))}
    .rule::before,.rule::after{content:"";flex:1;height:1px;background:currentColor}
    .rule i{width:.5rem;height:.5rem;background:currentColor;transform:rotate(45deg)}
    .label{background:var(--cream);border-radius:1.25rem;padding:1.75rem 1.5rem;text-align:center;outline:1.5px solid var(--accent,var(--purple));outline-offset:-.6rem}

    .hero{position:relative;isolation:isolate;display:grid;place-items:center;min-height:31rem;padding:5rem 1.25rem;overflow:hidden;background:#183b3b;color:var(--cream)}
    .sunburst{position:absolute;z-index:-1;width:min(64rem,110vw);aspect-ratio:1;left:50%;top:50%;translate:-50% -50%;border-radius:50%;background:repeating-radial-gradient(circle,transparent 0 3.2rem,rgba(127,209,199,.16) 3.25rem 3.32rem);opacity:.9}
    .hero-label{--accent:var(--teal);position:relative;max-width:42rem;width:100%;padding:1.5rem;text-align:center;background:transparent;border:0;outline:0;color:var(--cream)}
    .hero-label::before{display:none}
    .hero h1{font-size:clamp(4rem,13vw,7.5rem);color:var(--cream);letter-spacing:-.045em;margin:.55rem 0; text-wrap:balance}
    .hero .small{color:var(--teal)}
    .hero .rule{color:var(--sun);max-width:18rem;margin:1rem auto}
    .lead{font-family:"Source Serif 4",serif;font-style:italic;font-size:clamp(1.1rem,2vw,1.3rem);max-width:34rem;margin:0 auto .8rem}
    .meta{font-size:.85rem;font-weight:600;color:var(--teal);margin-bottom:1.25rem}
    .hero .btn{background:var(--sun);color:var(--ink)}

    .btn{display:inline-block;background:var(--ink);color:var(--cream);border:0;border-radius:99px;padding:.7rem 1.4rem;font:600 .95rem Archivo;text-decoration:none;cursor:pointer}
    .btn:hover{background:var(--wine)}
    .btn:disabled{opacity:.4;cursor:not-allowed}
    .wide{width:100%}

    .block{padding:4.5rem 1.25rem;max-width:72rem;margin:auto}
    .block h2{font-size:clamp(2rem,5vw,3rem);margin-bottom:2rem}
    .block.alt,.block.alt2{max-width:none}
    .block.alt{background:var(--night);color:var(--cream)}
    .block.alt2{background:var(--teal)}
    .block.alt>*,.block.alt2>*{max-width:72rem;margin-inline:auto}
    .grid{display:grid;gap:1.5rem}
    .cafes{grid-template-columns:repeat(auto-fit,minmax(19rem,1fr))}
    .simple{grid-template-columns:repeat(auto-fit,minmax(16rem,1fr))}

    .cafe{display:flex;flex-direction:column;border-radius:1.5rem;overflow:hidden;background:var(--bg)}
    .cafe.sol{--bg:var(--orange);--accent:var(--purple)}
    .cafe.arco{--bg:var(--night);--accent:var(--pink)}
    .cafe.olas{--bg:var(--wine);--accent:var(--wine)}
    .cafe.sol .rule{color:var(--orange)} .cafe.arco .rule{color:var(--green)}
    .photo{position:relative;aspect-ratio:5/4;overflow:hidden;background:var(--bg)}
    .photo img{display:block;width:100%;height:100%;object-fit:cover;object-position:center}
    .photo:after{content:"";position:absolute;inset:auto 0 0;height:14%;background:linear-gradient(to bottom,transparent,var(--bg));pointer-events:none}
    .cafe .label{margin:.75rem .75rem .75rem;position:relative;flex:1;display:flex;flex-direction:column}
    .cafe h3{font-size:2rem;color:var(--accent);margin-top:.35rem}
    .cafe.sol h3{color:var(--orange)}
    dl{display:grid;gap:.1rem}
    dt{font-size:.65rem;letter-spacing:.16em;text-transform:uppercase;font-weight:700;color:var(--accent);margin-top:.6rem}
    dd{font-family:"Source Serif 4",serif;font-weight:600;font-size:.98rem}
    dd.it{font-style:italic;font-weight:400}
    .cafe .small:last-of-type{margin-top:.7rem}
    .buy{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-top:auto;padding-top:1.1rem}
    .size-picker{display:flex;align-items:center;justify-content:space-between;gap:.8rem;margin-top:.85rem;color:var(--accent);font-size:.72rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase}
    .size-picker select{max-width:70%;padding:.55rem .7rem;border:1px solid currentColor;border-radius:.6rem;background:var(--cream);color:var(--ink);font:600 .85rem Archivo;letter-spacing:normal;text-transform:none}
    .grind-picker{display:flex;align-items:center;justify-content:space-between;gap:.8rem;margin-top:.6rem;color:var(--accent);font-size:.72rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase}
    .grind-picker select{width:min(70%,19rem);padding:.55rem .7rem;border:1px solid currentColor;border-radius:.6rem;background:var(--cream);color:var(--ink);font:600 .85rem Archivo;letter-spacing:normal;text-transform:none}
    .reserve{margin-top:.6rem;align-self:stretch}
    .price{font-family:"Source Serif 4",serif;font-weight:800;font-size:1.3rem}
    .price small{font-family:Archivo;font-weight:400;font-size:.75rem}
    .cafe .price{white-space:nowrap;flex:0 0 auto}
    .cafe .price small{white-space:nowrap}
    @media (max-width:650px){.cafe .buy{gap:.45rem}.cafe .price{font-size:clamp(1.05rem,4.2vw,1.3rem)}.cafe .price small{font-size:.68rem}.cafe .buy>.btn{padding-inline:.75rem}}
    @media (min-width:700px){
      .cafe .buy{gap:.4rem}
      .cafe .price{font-size:clamp(1rem,1.3vw,1.3rem);white-space:nowrap;flex:0 0 auto}
      .cafe .price small{font-size:.7rem;white-space:nowrap}
      .cafe .buy>.btn{padding-inline:.7rem;white-space:nowrap;text-align:center}
      .cafe h3{min-height:2em;display:grid;place-items:center}
    }

    .simple-card{display:flex;flex-direction:column;gap:.6rem;padding:1.5rem;border-radius:1.25rem;border:1.5px solid currentColor}
    .product-photo{width:9rem;height:9rem;flex:0 0 auto;margin:0 auto .7rem;border-radius:50%;overflow:hidden;background:#fff;padding:0}
    .product-photo img{width:100%;height:100%;object-fit:contain;transform:scale(1.18)}
    @media (min-width:700px){.product-photo{width:15rem;height:15rem}}
    .simple-card h3{font-size:1.6rem}
    .simple-card p{font-size:.95rem;max-width:34ch}
    .alt .btn{background:var(--sun);color:var(--ink)}
    .alt2 .btn:hover{background:var(--pink)}

    .presale-info{display:flex;align-items:center;justify-content:space-between;gap:2rem;padding:4rem max(1.25rem,calc((100% - 68rem)/2));background:var(--sun);color:var(--ink)}
    .presale-copy{max-width:42rem}.presale-copy .small{color:var(--wine)}
    .presale-copy h2{font-size:clamp(2.2rem,5vw,3.5rem);margin:.5rem 0 1rem}
    .presale-copy p:not(.small){max-width:62ch;margin-top:.7rem}
    .presale-mark{width:9rem;height:9rem;flex:0 0 auto;border:2px solid var(--ink);border-radius:50%;display:flex;align-items:center;justify-content:center;gap:.35rem;transform:rotate(-8deg)}
    .presale-mark strong{font:800 4rem/1 "Source Serif 4",serif}.presale-mark span{font-size:.8rem;font-weight:700;line-height:1.1}

    footer{padding:2rem 1.25rem;text-align:center;font-size:.85rem;background:var(--night);color:var(--cream)}

    dialog{margin:auto 0 auto auto;height:100dvh;max-height:none;width:min(26rem,100%);border:0;padding:1.5rem;background:var(--cream);color:var(--ink);overflow:auto}
    dialog::backdrop{background:rgba(0,0,0,.6)}
    dialog[open]{animation:in .25s ease-out}
    @keyframes in{from{translate:100% 0}}
    .cart-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem}
    .cart-head h2{font-size:1.8rem}
    .cart-head button{background:none;border:0;font:600 .9rem Archivo;text-decoration:underline;cursor:pointer}
    #lines{list-style:none;padding:0}
    #lines li{display:grid;grid-template-columns:3.25rem minmax(0,1fr) auto auto;gap:.65rem;align-items:center;padding:.7rem 0;border-bottom:1px solid #0002;font-size:.92rem}
    .cart-thumb{display:block;width:3.25rem;height:3.25rem;object-fit:cover;border-radius:.55rem;background:#fff}
    .cart-product{min-width:0;font-weight:600;line-height:1.25}
    .cart-product-link{min-width:0;color:inherit;font-weight:600;line-height:1.25;text-decoration:none}.cart-product-link:hover{text-decoration:underline;text-underline-offset:.15em}.cart-thumb-link{display:block;border-radius:.55rem}.cart-thumb-link:focus-visible,.cart-product-link:focus-visible{outline:3px solid var(--pink);outline-offset:3px}
    .qty{display:flex;align-items:center;gap:.5rem}
    .qty button{width:1.8rem;height:1.8rem;border-radius:50%;border:1.5px solid var(--ink);background:none;cursor:pointer;font-size:1rem}
    .total{display:flex;justify-content:space-between;margin:1.25rem 0;font-family:"Source Serif 4",serif;font-size:1.4rem}
    dialog label{display:block;font-size:.85rem;font-weight:600;margin-bottom:.8rem}
    dialog input,dialog select{display:block;width:100%;margin-top:.25rem;padding:.6rem .7rem;border:1.5px solid var(--ink);border-radius:.5rem;background:#fff8;font:1rem Archivo;color:var(--ink)}
    .shipping-row{display:flex;justify-content:space-between;gap:1rem;margin:.5rem 0;font-size:.9rem}.shipping-row small{display:block;color:#62584c;font-size:.72rem;font-weight:400}
    .payment-note,.payment-error{margin:.65rem 0;font-size:.8rem;line-height:1.4}.payment-note{color:#4f463c}.payment-error{color:#9b0e1a;font-weight:700}.payment-error[hidden]{display:none}.whatsapp-order{margin-top:.65rem;background:transparent;color:var(--ink);border:1px solid var(--ink)}.whatsapp-order:hover{background:#0000000a}
    .fine{font-size:.78rem;margin-top:.8rem;text-align:center}
    @media (max-width:650px){.top{gap:.55rem;padding:.6rem .7rem}.logo img{width:6.7rem}.top nav{display:none;position:absolute;left:0;right:0;top:100%;translate:0 0;width:100%;flex-direction:column;gap:0;padding:.4rem 1rem .8rem;background:var(--night);white-space:normal}.top.menu-open nav{display:flex}.top nav a{padding:.75rem .25rem;font-size:.95rem;border-top:1px solid #efe6d233}.top .cartbtn{margin-left:auto;padding:.4rem .7rem;font-size:.78rem;white-space:nowrap}.menu-toggle{display:grid;place-content:center;gap:4px;width:2.2rem;height:2.2rem;flex:0 0 auto;border:1px solid #efe6d255;border-radius:50%;background:transparent;color:var(--cream);cursor:pointer}.menu-toggle span{display:block;width:1rem;height:2px;background:currentColor;transition:transform .2s,opacity .2s}.top.menu-open .menu-toggle span:first-child{transform:translateY(6px) rotate(45deg)}.top.menu-open .menu-toggle span:nth-child(2){opacity:0}.top.menu-open .menu-toggle span:last-child{transform:translateY(-6px) rotate(-45deg)}}
    @media (max-width:560px){.presale-info{padding-block:3rem;align-items:flex-start}.presale-mark{width:6rem;height:6rem}.presale-mark strong{font-size:2.8rem}.presale-mark span{font-size:.65rem}}
    .brand-intro{display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,7vw,6rem);align-items:end;max-width:72rem;margin:0 auto;padding:clamp(4rem,9vw,7rem) 1.25rem;background:var(--cream);color:var(--ink)}
    .brand-intro .small{color:var(--green)}
    .brand-intro h2{max-width:14ch;margin-top:.9rem;font:800 clamp(2.5rem,5.5vw,4.4rem)/1.02 "Source Serif 4",Georgia,serif;letter-spacing:-.035em}
    .brand-intro h2 span{color:var(--green)}
    .intro-copy{max-width:37rem;font-size:clamp(1rem,1.65vw,1.13rem)}
    .intro-copy p+p{margin-top:1rem}
    .intro-copy a{display:inline-flex;gap:.55rem;align-items:center;margin-top:1.5rem;color:var(--green);font-weight:700;text-decoration:none}
    .intro-copy a:hover{text-decoration:underline;text-underline-offset:.2em}
    .site-footer{padding:2.5rem clamp(1.25rem,3.5vw,4.5rem) 1.5rem;background:var(--night);color:var(--cream);text-align:left}
    .footer-top,.footer-bottom{display:flex;justify-content:space-between;align-items:center;gap:1rem;text-transform:uppercase;letter-spacing:.12em;font-size:clamp(.65rem,1.1vw,.85rem)}
    .footer-top{padding-bottom:1rem;border-bottom:1px solid #efe6d288}
    .footer-top a,.footer-bottom a{color:inherit;text-decoration:none}
    .footer-top a:hover,.footer-bottom a:hover{text-decoration:underline;text-underline-offset:.25em}
    .footer-wordmark{display:block;width:max-content;max-width:100%;margin:clamp(4rem,11vw,9rem) auto clamp(4rem,11vw,9rem) 0;overflow:hidden;color:var(--cream);font:700 clamp(3rem,17.7vw,16rem)/.78 Archivo,Arial,sans-serif;letter-spacing:-.075em;white-space:nowrap;text-decoration:none}
    .footer-bottom{color:var(--cream)}
    @media(max-width:650px){.brand-intro{grid-template-columns:1fr;gap:1.25rem;padding-block:3.5rem}.brand-intro h2{max-width:12ch;font-size:clamp(2.6rem,11.5vw,3.6rem)}.intro-copy{font-size:1rem}.site-footer{padding:1.5rem 1rem 1.1rem}.footer-top,.footer-bottom{font-size:.58rem;letter-spacing:.08em}.footer-wordmark{font-size:17.3vw;margin:4.5rem 0;letter-spacing:-.075em}}
    @media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}dialog[open]{animation:none}}
  </style>
</body>
</html>
