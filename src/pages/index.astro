---
import { products } from '../data/products';
import { config } from '../data/config';
const cop = (n: number) => '$' + n.toLocaleString('es-CO');
const cafes = products.filter(p => p.category === 'cafe');
const metodos = products.filter(p => p.category === 'metodo');
const filtros = products.filter(p => p.category === 'filtro');
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Preventa de café · {config.brand}</title>
  <meta name="description" content="Preventa de tres cafés de especialidad del Huila, en bolsas de 250 g." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,600..800;1,9..144,400&family=Archivo:wght@400;600;700&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="top">
    <a class="logo" href="#top" aria-label={config.brand}>LOGO</a>
    <nav>
      <a href="#cafes">Cafés</a><a href="#metodos">Métodos</a><a href="#filtros">Filtros</a>
    </nav>
    <button class="cartbtn" id="open-cart">Carrito <b id="count">0</b></button>
  </header>

  <main id="top">
    <section class="hero">
      <div class="sunburst" aria-hidden="true"></div>
      <div class="label hero-label">
        <p class="small">Café de especialidad · Colombia</p>
        <h1>Preventa</h1>
        <div class="rule"><i></i></div>
        <p class="lead">Tres cafés del Huila en bolsa de 250 g. Aparta el tuyo y sé parte de esta primera preventa.</p>
        <p class="meta">{config.presaleEnd}</p>
        <a class="btn" href="#cafes">Ver los cafés</a>
      </div>
    </section>

    <section id="cafes" class="block">
      <h2>Los tres cafés</h2>
      <div class="grid cafes">
        {cafes.map(p => (
          <article class={`card cafe ${p.theme}`}>
            <div class="photo"><img src={p.img} alt={`Bolsa de café ${p.name}`} loading="lazy" /></div>
            <div class="label">
              <p class="small">{p.tag}</p>
              <h3>{p.name}</h3>
              <div class="rule"><i></i></div>
              <dl>
                <dt>Proceso</dt><dd>{p.process}</dd>
                <dt>Productor</dt><dd>{p.producer}</dd>
                <dt>Finca</dt><dd>{p.farm}</dd>
              </dl>
              <p class="small">{p.origin}</p>
              <div class="buy">
                <span class="price">{cop(p.price)} <small>· 250 g</small></span>
                <a class="btn" href={`/cafes/${p.id}`}>Conocer café</a>
              </div>
              <button class="btn add reserve" data-id={p.id}>Reservar</button>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="presale-info">
      <div class="presale-copy">
        <p class="small">Una preventa en lotes pequeños</p>
        <h2>10 kg de cada café</h2>
        <p>Por ahora decidimos sacar 10 kg de cada café. Cuando completemos la preventa de uno, procesamos su tueste y preparamos el despacho.</p>
        <p>Así tostamos según lo que se reservó. Los despachos están previstos para la primera semana de diciembre.</p>
      </div>
      <div class="presale-mark" aria-hidden="true"><strong>10</strong><span>kg<br />por café</span></div>
    </section>

    <section id="metodos" class="block alt">
      <h2>Métodos</h2>
      <div class="grid simple">
        {metodos.map(p => (
          <article class="card simple-card">
            {p.img && <div class="product-photo"><img src={p.img} alt={p.name} loading="lazy" /></div>}
            <h3>{p.name}</h3><p>{p.note}</p>
            <div class="buy"><span class="price">{cop(p.price)}</span>
            <button class="btn add" data-id={p.id}>Agregar</button></div>
          </article>
        ))}
      </div>
    </section>

    <section id="filtros" class="block alt2">
      <h2>Filtros</h2>
      <div class="grid simple">
        {filtros.map(p => (
          <article class="card simple-card">
            {p.img && <div class="product-photo"><img src={p.img} alt={p.name} loading="lazy" /></div>}
            <h3>{p.name}</h3><p>{p.note}</p>
            <div class="buy"><span class="price">{cop(p.price)}</span>
            <button class="btn add" data-id={p.id}>Agregar</button></div>
          </article>
        ))}
      </div>
    </section>
  </main>

  <footer><p>{config.brand} · {config.shipping}</p></footer>

  <dialog id="cart">
    <form method="dialog" class="cart-head"><h2>Tu pedido</h2><button aria-label="Cerrar">Cerrar</button></form>
    <ul id="lines"></ul>
    <p id="empty">Aún no has agregado nada.</p>
    <div class="total"><span>Total</span><strong id="total">$0</strong></div>
    <label>Nombre<input id="name" autocomplete="name" /></label>
    <label>Ciudad<input id="city" autocomplete="address-level2" /></label>
    <button class="btn wide" id="send" disabled>Enviar pedido por WhatsApp</button>
    <p class="fine">Te confirmamos el pago y el envío por WhatsApp.</p>
  </dialog>

  <script is:inline define:vars={{ products, config }}>
    const fmt = n => '$' + n.toLocaleString('es-CO');
    let cart = {};
    try { cart = JSON.parse(localStorage.getItem('cart') || '{}'); } catch {}
    const $ = s => document.querySelector(s);
    const dlg = $('#cart');
    function save() { try { localStorage.setItem('cart', JSON.stringify(cart)); } catch {} render(); }
    function render() {
      const ids = Object.keys(cart).filter(id => cart[id] > 0);
      let total = 0, count = 0;
      $('#lines').innerHTML = ids.map(id => {
        const p = products.find(x => x.id === id); const q = cart[id];
        total += p.price * q; count += q;
        return `<li><span>${p.name}${p.category === 'cafe' ? ' · 250 g' : ''}</span>
          <span class="qty"><button data-d="-1" data-id="${id}" aria-label="Quitar uno">−</button><b>${q}</b><button data-d="1" data-id="${id}" aria-label="Agregar uno">+</button></span>
          <span>${fmt(p.price * q)}</span></li>`;
      }).join('');
      $('#empty').hidden = ids.length > 0;
      $('#total').textContent = fmt(total);
      $('#count').textContent = count;
      $('#send').disabled = !ids.length;
    }
    document.addEventListener('click', e => {
      const add = e.target.closest('.add');
      if (add) {
        cart[add.dataset.id] = (cart[add.dataset.id] || 0) + 1; save();
        const t = add.textContent; add.textContent = 'Agregado'; setTimeout(() => add.textContent = t, 900);
      }
      const step = e.target.closest('[data-d]');
      if (step) { cart[step.dataset.id] = Math.max(0, (cart[step.dataset.id] || 0) + Number(step.dataset.d)); save(); }
    });
    $('#open-cart').onclick = () => dlg.showModal();
    $('#send').onclick = () => {
      const ids = Object.keys(cart).filter(id => cart[id] > 0);
      let total = 0;
      const lines = ids.map(id => { const p = products.find(x => x.id === id); total += p.price * cart[id];
        return `• ${cart[id]} × ${p.name}${p.category === 'cafe' ? ' (250 g)' : ''} — ${fmt(p.price * cart[id])}`; });
      const msg = `Hola, quiero hacer un pedido de preventa:\n${lines.join('\n')}\nTotal: ${fmt(total)}\nNombre: ${$('#name').value}\nCiudad: ${$('#city').value}`;
      window.open(`https://wa.me/${config.whatsapp}?text=${encodeURIComponent(msg)}`, '_blank');
    };
    render();
  </script>

  <style is:global>
    :root {
      --cream:#efe6d2; --ink:#1a120d; --orange:#f07b1d; --sun:#f7b32b; --teal:#7fd1c7;
      --pink:#e6007e; --green:#0e6b4a; --wine:#9b0e1a; --night:#0c0c0c; --purple:#6a1b7a;
    }
    *{box-sizing:border-box;margin:0}
    html{scroll-behavior:smooth}
    body{font-family:Archivo,system-ui,sans-serif;background:var(--cream);color:var(--ink);line-height:1.5}
    h1,h2,h3{font-family:Fraunces,Georgia,serif;font-weight:800;line-height:1}
    a{color:inherit}
    :focus-visible{outline:3px solid var(--pink);outline-offset:2px}
    .top{position:sticky;top:0;z-index:5;display:flex;align-items:center;gap:1rem;padding:.6rem 1.25rem;background:var(--night);color:var(--cream)}
    .logo{width:2.6rem;aspect-ratio:1;border:1.5px dashed var(--sun);border-radius:50%;display:grid;place-items:center;font-size:.6rem;font-weight:700;text-decoration:none}
    .top nav{display:flex;gap:1.25rem;margin-inline:auto}
    .top nav a{text-decoration:none;font-size:.95rem}
    .top nav a:hover{color:var(--sun)}
    .cartbtn{background:var(--sun);color:var(--ink);border:0;border-radius:99px;padding:.45rem 1rem;font:600 .9rem Archivo;cursor:pointer}
    .cartbtn b{background:var(--ink);color:var(--sun);border-radius:99px;padding:0 .5rem;margin-left:.3rem}

    .small{font-size:.7rem;letter-spacing:.16em;text-transform:uppercase;font-weight:700;color:var(--accent,var(--green))}
    .rule{display:flex;align-items:center;gap:.6rem;margin:1rem 0;color:var(--accent,var(--wine))}
    .rule::before,.rule::after{content:"";flex:1;height:1px;background:currentColor}
    .rule i{width:.5rem;height:.5rem;background:currentColor;transform:rotate(45deg)}
    .label{background:var(--cream);border-radius:1.25rem;padding:1.75rem 1.5rem;text-align:center;outline:1.5px solid var(--accent,var(--purple));outline-offset:-.6rem}

    .hero{position:relative;isolation:isolate;display:grid;place-items:center;min-height:31rem;padding:5rem 1.25rem;overflow:hidden;background:#183b3b;color:var(--cream)}
    .sunburst{position:absolute;z-index:-1;width:min(64rem,110vw);aspect-ratio:1;left:50%;top:50%;translate:-50% -50%;border-radius:50%;background:repeating-radial-gradient(circle,transparent 0 3.2rem,rgba(127,209,199,.16) 3.25rem 3.32rem);opacity:.9}
    .hero-label{--accent:var(--teal);position:relative;max-width:42rem;width:100%;padding:1.5rem;text-align:center;background:transparent;border:0;outline:0;color:var(--cream)}
    .hero-label::before{display:none}
    .hero h1{font-size:clamp(4rem,13vw,7.5rem);color:var(--cream);letter-spacing:-.045em;margin:.55rem 0; text-wrap:balance}
    .hero .small{color:var(--teal)}
    .hero .rule{color:var(--sun);max-width:18rem;margin:1rem auto}
    .lead{font-family:Fraunces,serif;font-style:italic;font-size:clamp(1.1rem,2vw,1.3rem);max-width:34rem;margin:0 auto .8rem}
    .meta{font-size:.85rem;font-weight:600;color:var(--teal);margin-bottom:1.25rem}
    .hero .btn{background:var(--sun);color:var(--ink)}

    .btn{display:inline-block;background:var(--ink);color:var(--cream);border:0;border-radius:99px;padding:.7rem 1.4rem;font:600 .95rem Archivo;text-decoration:none;cursor:pointer}
    .btn:hover{background:var(--wine)}
    .btn:disabled{opacity:.4;cursor:not-allowed}
    .wide{width:100%}

    .block{padding:4.5rem 1.25rem;max-width:72rem;margin:auto}
    .block h2{font-size:clamp(2rem,5vw,3rem);margin-bottom:2rem}
    .block.alt,.block.alt2{max-width:none}
    .block.alt{background:var(--night);color:var(--cream)}
    .block.alt2{background:var(--teal)}
    .block.alt>*,.block.alt2>*{max-width:72rem;margin-inline:auto}
    .grid{display:grid;gap:1.5rem}
    .cafes{grid-template-columns:repeat(auto-fit,minmax(19rem,1fr))}
    .simple{grid-template-columns:repeat(auto-fit,minmax(16rem,1fr))}

    .cafe{display:flex;flex-direction:column;border-radius:1.5rem;overflow:hidden;background:var(--bg)}
    .cafe.sol{--bg:var(--orange);--accent:var(--purple)}
    .cafe.arco{--bg:var(--night);--accent:var(--pink)}
    .cafe.olas{--bg:var(--wine);--accent:var(--wine)}
    .cafe.sol .rule{color:var(--orange)} .cafe.arco .rule{color:var(--green)}
    .photo{aspect-ratio:4/4.4;overflow:hidden}
    .photo img{width:100%;height:100%;object-fit:cover;object-position:52% 50%;transform:scale(1.55);transform-origin:52% 52%}
    .cafe .label{margin:-2.5rem .75rem .75rem;position:relative;flex:1;display:flex;flex-direction:column}
    .cafe h3{font-size:2rem;color:var(--accent);margin-top:.35rem}
    .cafe.sol h3{color:var(--orange)}
    dl{display:grid;gap:.1rem}
    dt{font-size:.65rem;letter-spacing:.16em;text-transform:uppercase;font-weight:700;color:var(--accent);margin-top:.6rem}
    dd{font-family:Fraunces,serif;font-weight:600;font-size:.98rem}
    dd.it{font-style:italic;font-weight:400}
    .cafe .small:last-of-type{margin-top:.7rem}
    .buy{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-top:auto;padding-top:1.1rem}
    .reserve{margin-top:.6rem;align-self:stretch}
    .price{font-family:Fraunces,serif;font-weight:800;font-size:1.3rem}
    .price small{font-family:Archivo;font-weight:400;font-size:.75rem}
    @media (min-width:700px){
      .cafe .buy{gap:.4rem}
      .cafe .price{font-size:clamp(1rem,1.3vw,1.3rem);white-space:nowrap;flex:0 0 auto}
      .cafe .price small{font-size:.7rem;white-space:nowrap}
      .cafe .buy>.btn{padding-inline:.7rem;white-space:nowrap;text-align:center}
      .cafe h3{min-height:2em;display:grid;place-items:center}
    }

    .simple-card{display:flex;flex-direction:column;gap:.6rem;padding:1.5rem;border-radius:1.25rem;border:1.5px solid currentColor}
    .product-photo{width:9rem;height:9rem;flex:0 0 auto;margin:0 auto .7rem;border-radius:50%;overflow:hidden;background:#fff;padding:0}
    .product-photo img{width:100%;height:100%;object-fit:contain;transform:scale(1.18)}
    @media (min-width:700px){.product-photo{width:15rem;height:15rem}}
    .simple-card h3{font-size:1.6rem}
    .simple-card p{font-size:.95rem;max-width:34ch}
    .alt .btn{background:var(--sun);color:var(--ink)}
    .alt2 .btn:hover{background:var(--pink)}

    .presale-info{display:flex;align-items:center;justify-content:space-between;gap:2rem;padding:4rem max(1.25rem,calc((100% - 68rem)/2));background:var(--sun);color:var(--ink)}
    .presale-copy{max-width:42rem}.presale-copy .small{color:var(--wine)}
    .presale-copy h2{font-size:clamp(2.2rem,5vw,3.5rem);margin:.5rem 0 1rem}
    .presale-copy p:not(.small){max-width:62ch;margin-top:.7rem}
    .presale-mark{width:9rem;height:9rem;flex:0 0 auto;border:2px solid var(--ink);border-radius:50%;display:flex;align-items:center;justify-content:center;gap:.35rem;transform:rotate(-8deg)}
    .presale-mark strong{font:800 4rem/1 Fraunces,serif}.presale-mark span{font-size:.8rem;font-weight:700;line-height:1.1}

    footer{padding:2rem 1.25rem;text-align:center;font-size:.85rem;background:var(--night);color:var(--cream)}

    dialog{margin:auto 0 auto auto;height:100dvh;max-height:none;width:min(26rem,100%);border:0;padding:1.5rem;background:var(--cream);color:var(--ink);overflow:auto}
    dialog::backdrop{background:rgba(0,0,0,.6)}
    dialog[open]{animation:in .25s ease-out}
    @keyframes in{from{translate:100% 0}}
    .cart-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem}
    .cart-head h2{font-size:1.8rem}
    .cart-head button{background:none;border:0;font:600 .9rem Archivo;text-decoration:underline;cursor:pointer}
    #lines{list-style:none;padding:0}
    #lines li{display:grid;grid-template-columns:1fr auto auto;gap:.8rem;align-items:center;padding:.7rem 0;border-bottom:1px solid #0002;font-size:.92rem}
    .qty{display:flex;align-items:center;gap:.5rem}
    .qty button{width:1.8rem;height:1.8rem;border-radius:50%;border:1.5px solid var(--ink);background:none;cursor:pointer;font-size:1rem}
    .total{display:flex;justify-content:space-between;margin:1.25rem 0;font-family:Fraunces,serif;font-size:1.4rem}
    dialog label{display:block;font-size:.85rem;font-weight:600;margin-bottom:.8rem}
    dialog input{display:block;width:100%;margin-top:.25rem;padding:.6rem .7rem;border:1.5px solid var(--ink);border-radius:.5rem;background:#fff8;font:1rem Archivo}
    .fine{font-size:.78rem;margin-top:.8rem;text-align:center}
    @media (max-width:560px){.top nav{display:none}.top .cartbtn{margin-left:auto}.presale-info{padding-block:3rem;align-items:flex-start}.presale-mark{width:6rem;height:6rem}.presale-mark strong{font-size:2.8rem}.presale-mark span{font-size:.65rem}}
    @media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}dialog[open]{animation:none}}
  </style>
</body>
</html>
