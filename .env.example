# Copia este archivo a .env.local y pega allí el Access Token de prueba.
MP_ENVIRONMENT=test
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# URL base del proyecto (sin /rest/v1) y clave secreta de Supabase.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Opcional; en local se usa el origen del servidor de desarrollo.
PUBLIC_SITE_URL=http://localhost:4321

# Correos (Resend, https://resend.com). EMAIL_FROM debe usar un dominio verificado en Resend,
# por ejemplo: ØPPOSITE <pedidos@tudominio.com>
RESEND_API_KEY=
EMAIL_FROM=
# Quién recibe los pedidos (puedes poner varios separados por coma).
ORDER_NOTIFY_EMAIL=
# Quién recibe las postulaciones de "Trabaja con nosotros". Si lo dejas vacío se usa ORDER_NOTIFY_EMAIL.
JOBS_NOTIFY_EMAIL=
