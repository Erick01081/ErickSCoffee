# Copia este archivo a .env.local y pega allí el Access Token de prueba.
MP_ENVIRONMENT=test
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# URL base del proyecto (sin /rest/v1) y clave secreta de Supabase.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Opcional; en local se usa el origen del servidor de desarrollo.
PUBLIC_SITE_URL=http://localhost:4321
